# Anchored to the repo root — an unanchored "brand/" also matches
# assets/brand/ (gitignore semantics) and strips the site's own images,
# which is exactly what broke the first deployment.
/brand/
/README.md
/server.js

# Marketing asset generators — repo only, never served.
/marketing/

# Shirt-photo masters and the processing pipeline — the site serves only
# the normalized .webp files in /assets/shirts/.
/assets/shirts/raw/
/assets/feed/raw/
/tools/
